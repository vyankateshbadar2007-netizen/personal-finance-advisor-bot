FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Google Gemini API
GEMINI_API_KEY=
# SkillWallet brief references gemini-2.0-flash.
# Google's current model catalog lists gemini-2.0-flash as shut down,
# so this project defaults to a current Flash model for working integration.
GEMINI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048

# Optional Google Sheets Apps Script Web App endpoint
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional database URL override
# DATABASE_URL=sqlite:///finance_advisor.db

# Optional Ngrok token for run_public.py
NGROK_AUTHTOKEN=
